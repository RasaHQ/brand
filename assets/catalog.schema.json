{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rasa asset catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "category",
          "status",
          "format",
          "sha256",
          "bytes",
          "roles",
          "rights",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^assets/"
          },
          "status": {
            "enum": [
              "current",
              "reference",
              "archived"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array"
          }
        }
      }
    }
  }
}
